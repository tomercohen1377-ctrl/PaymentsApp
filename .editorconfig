root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = intellij_idea
# Leave signature layout to the author (one parameter per line is the house style).
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled
max_line_length = 120
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# The codebase uses trailing commas everywhere (cleaner diffs).
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Backticked test names may exceed the line length.
ktlint_ignore_back_ticked_identifier = true
